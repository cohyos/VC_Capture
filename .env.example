# Gemini API Key (server-side only — never exposed to client)
GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Admin SDK credentials
# Get from: Firebase Console > Project Settings > Service Accounts > Generate New Private Key
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Stripe
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxx

# Stripe Price IDs — create these in Stripe Dashboard > Products
# Each maps to a credit pack defined in lib/pricing.js
STRIPE_PRICE_PACK_10=price_xxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PACK_25=price_xxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PACK_50=price_xxxxxxxxxxxxxxxxxx
STRIPE_PRICE_PACK_100=price_xxxxxxxxxxxxxxxxxx

# App URL (used for Stripe redirect URLs)
APP_URL=https://your-project.vercel.app
